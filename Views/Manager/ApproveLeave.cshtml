@model List<LeaveManagement.Models.Leave>

@{
    ViewBag.Title = "ApproveLeave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-12">
    <div class="card col-md-12">
        @if (TempData["ResponseMSG"] != null)
        {
            <label>@TempData["ResponseMSG"].ToString()</label>
        }
    </div>

    <div class="col-md-12">
        <div class="card shadow-sm p-3">
            <h5>Leave Status</h5>
            <table class="table table-bordered table-hover mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>EmpID</th>
                        <th>EmpName</th>
                        <th>StartDate</th>
                        <th>EndDate</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Approve</th>
                        <th>Reject</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var i in Model)
                        {
                            <tr>
                                <td>@i.Id</td>
                                <td>@i.EmployeeId</td>
                                <td>@i.EmployeeName</td>
                                <td>@i.StartDate</td>
                                <td>@i.EndDate</td>
                                <td>@i.Reason</td>
                                <td>@i.Status</td>
                                <td>
                                    @Html.ActionLink("Approve", "Approve", "Manager", new { id = i.Id }, new { @class = "btn btn-success btn-sm" })
                                </td>
                                <td>
                                    @Html.ActionLink("Reject", "Reject", "Manager", new { id = i.Id }, new { @class = "btn btn-danger btn-sm" })
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
</div>

